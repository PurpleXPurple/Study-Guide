{
  "app": {
    "title": "LogicDeck",
    "tagline": "Digital logic, one tap at a time.",
    "version": "1.0.0"
  },
  "quiz": {
    "questionsPerRound": 10,
    "shuffleQuestions": true,
    "shuffleOptions": true
