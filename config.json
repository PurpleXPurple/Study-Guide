    "stepsDrawer": true,
    "persistProgress": true,
    "keyboardShortcuts": true,
    "haptics": true
  },
  "ui": {
    "defaultCategory": "all",
    "animationSpeed": "animate__faster"
  },
  "categories": [
    { "id": "all",    "label": "Everything" },
    { "id": "gates",  "label": "Logic Gates" },
    { "id": "bool",   "label": "Boolean Algebra" },
    { "id": "kmap",   "label": "K-Maps" },
    { "id": "bin",    "label": "Binary" },
    { "id": "signed", "label": "Signed Numbers" }
  ]
}